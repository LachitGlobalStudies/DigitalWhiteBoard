cat << 'EOF' > .gitignore
# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/

# Gradle files
.gradle/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# OS-specific files
.DS_Store
Thumbs.db
EOF